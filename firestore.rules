rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Role Helpers
    function isAuthenticated() {
      return request.auth != null;
    }
    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.role == 'superadmin';
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isOwnerTutor(tutorId) {
      return isAuthenticated() && request.auth.token.role == 'tutor' && request.auth.token.tutorId == tutorId;
    }

    function isValidReview() {
      let d = request.resource.data;
      return (
        (d.institutionId is string && d.institutionId.size() > 0
          && exists(/databases/$(database)/documents/institutions/$(d.institutionId)))
        || (d.tutorId is string && d.tutorId.size() > 0
          && exists(/databases/$(database)/documents/tutors/$(d.tutorId)))
      )
        && d.reviewerName is string && d.reviewerName.size() > 0 && d.reviewerName.size() <= 100
        && d.rating is int && d.rating >= 1 && d.rating <= 5
        && d.comment is string && d.comment.size() > 0 && d.comment.size() <= 2000
        && d.status == 'PENDING';
    }

    function isValidInquiry() {
      let d = request.resource.data;
      return d.institutionId is string && d.institutionId.size() > 0
        && exists(/databases/$(database)/documents/institutions/$(d.institutionId))
        && d.fullName is string && d.fullName.size() > 0 && d.fullName.size() <= 100
        && d.phone is string && d.phone.size() > 0 && d.phone.size() <= 30
        && d.message is string && d.message.size() <= 2000
        && d.status == 'NEW';
    }

    // Dynamic Master Data (Locations, Categories, Taxonomies, Settings): Public Read, Superadmin Write
    match /locations_governorates/{govId} {
      allow read: if true;
      allow write: if isSuperAdmin();
      match /cities/{cityId} {
        allow read: if true;
        allow write: if isSuperAdmin();
      }
    }

    match /categories/{catId} {
      allow read: if true;
      allow write: if isSuperAdmin();
      match /subcategories/{subId} {
        allow read: if true;
        allow write: if isSuperAdmin();
      }
    }

    match /taxonomies_master/{taxId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Institutions Directory
    match /institutions/{instId} {
      allow read: if resource.data.status == 'ACTIVE' || isSuperAdmin();
      allow write: if isSuperAdmin();
      match /programs/{progId} {
        allow read: if true;
        allow write: if isSuperAdmin();
      }
    }

    // Private Tutors Directory
    match /tutors/{tutorId} {
      allow read: if resource.data.status == 'ACTIVE' || isSuperAdmin() || isOwnerTutor(tutorId);
      allow write: if isSuperAdmin() || isOwner(resource.data.userId) || isOwnerTutor(tutorId);
    }

    // Tutoring Session Bookings (individual or group). Writes only via the Admin SDK
    // API route (/api/bookings) so group-join price recalculation stays transactional
    // and student contact info in `participants` isn't exposed to arbitrary readers.
    match /bookings/{bookingId} {
      allow read, update, delete: if isSuperAdmin() || isOwnerTutor(resource.data.tutorId);
      allow create: if false;
    }

    // User Reviews (Public read approved, Authenticated create)
    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'APPROVED' || isSuperAdmin();
      allow create: if isAuthenticated() && isValidReview();
      allow update, delete: if isSuperAdmin();
    }

    // Inquiries & Leads (Anyone can create inquiry, only recipient/admin can read)
    match /inquiries/{inquiryId} {
      allow create: if isValidInquiry();
      allow read, update, delete: if isSuperAdmin();
    }
  }
}
