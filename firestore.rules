rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Role Helpers
    function isAuthenticated() {
      return request.auth != null;
    }
    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.role == 'superadmin';
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isOwnerTutor(tutorId) {
      return isAuthenticated() && request.auth.token.role == 'tutor' && request.auth.token.tutorId == tutorId;
    }

    function isOwnerInstitution(instId) {
      return isAuthenticated() && request.auth.token.role == 'institution' && request.auth.token.institutionId == instId;
    }

    function isOwnerEmployer(employerId) {
      return isAuthenticated() && request.auth.token.role == 'employer' && request.auth.token.employerId == employerId;
    }

    // A Job/JobApplication has exactly one of institutionId/employerId set — same pattern as
    // Review's institutionId?/tutorId?. `.get(key, null)` handles the genuinely-absent-field case.
    function isOwnerOfJob(data) {
      return isOwnerInstitution(data.get('institutionId', null)) || isOwnerEmployer(data.get('employerId', null));
    }

    function isValidInquiry() {
      let d = request.resource.data;
      return d.institutionId is string && d.institutionId.size() > 0
        && exists(/databases/$(database)/documents/institutions/$(d.institutionId))
        && d.fullName is string && d.fullName.size() > 0 && d.fullName.size() <= 100
        && d.phone is string && d.phone.size() > 0 && d.phone.size() <= 30
        && d.message is string && d.message.size() <= 2000
        && d.status == 'NEW';
    }

    function isValidApplication() {
      let d = request.resource.data;
      return d.type in ['TUTOR', 'INSTITUTION', 'EMPLOYER']
        && d.fullName is string && d.fullName.size() > 0 && d.fullName.size() <= 150
        && d.email is string && d.email.size() > 0 && d.email.size() <= 200
        && d.phone is string && d.phone.size() > 0 && d.phone.size() <= 30
        && d.governorateId is string && d.governorateId.size() > 0
        && d.message is string && d.message.size() <= 3000
        && d.status == 'PENDING'
        && (d.type != 'INSTITUTION' || (d.categoryId is string && d.categoryId.size() > 0))
        && (d.type != 'EMPLOYER' || d.employerType in ['COMPANY', 'NGO']);
    }

    // Dynamic Master Data (Locations, Categories, Taxonomies, Settings): Public Read, Superadmin Write
    match /locations_governorates/{govId} {
      allow read: if true;
      allow write: if isSuperAdmin();
      match /cities/{cityId} {
        allow read: if true;
        allow write: if isSuperAdmin();
      }
    }

    match /categories/{catId} {
      allow read: if true;
      allow write: if isSuperAdmin();
      match /subcategories/{subId} {
        allow read: if true;
        allow write: if isSuperAdmin();
      }
    }

    match /taxonomies_master/{taxId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Institutions Directory
    match /institutions/{instId} {
      allow read: if resource.data.status == 'ACTIVE' || isSuperAdmin() || isOwnerInstitution(instId);
      allow write: if isSuperAdmin() || isOwner(resource.data.userId) || isOwnerInstitution(instId);
      match /programs/{progId} {
        allow read: if true;
        allow write: if isSuperAdmin() || isOwnerInstitution(instId);
      }

      // Verification/accreditation documents — same private-subcollection pattern as tutors,
      // since the institution doc above is world-readable once status is 'ACTIVE' with no
      // field-level restriction, and Storage download-URL tokens bypass storage.rules anyway.
      match /private/{docId} {
        allow read, write: if isSuperAdmin() || isOwnerInstitution(instId);
      }
    }

    // Private Tutors Directory
    match /tutors/{tutorId} {
      allow read: if resource.data.status == 'ACTIVE' || isSuperAdmin() || isOwnerTutor(tutorId);
      allow write: if isSuperAdmin() || isOwner(resource.data.userId) || isOwnerTutor(tutorId);

      // Verification documents (ID/certificate photos) live here instead of on the tutor doc
      // above, because that doc's read rule has no field-level restriction — anything on it
      // is world-readable the moment status is 'ACTIVE'. Storage download-URL tokens also
      // bypass storage.rules on a direct fetch, so keeping these URLs off the public doc is
      // the only real privacy boundary for identity documents.
      match /private/{docId} {
        allow read, write: if isSuperAdmin() || isOwnerTutor(tutorId);
      }
    }

    // Employers (companies/NGOs) — narrower than Institutions: no public directory profile page,
    // no programs/verification-docs subcollection, they only ever get read for job-listing display.
    match /employers/{employerId} {
      allow read: if resource.data.status == 'ACTIVE' || isSuperAdmin() || isOwnerEmployer(employerId);
      allow write: if isSuperAdmin() || isOwner(resource.data.userId) || isOwnerEmployer(employerId);
    }

    // Tutoring Session Bookings (individual or group). Writes only via the Admin SDK
    // API route (/api/bookings), which requires a logged-in student session, so group-join
    // price recalculation stays transactional and student contact info in `participants`
    // isn't exposed to arbitrary readers.
    match /bookings/{bookingId} {
      allow read, update, delete: if isSuperAdmin() || isOwnerTutor(resource.data.tutorId);
      allow create: if false;
    }

    // User Reviews (Public read approved). Creation is Admin SDK only (/api/reviews) — it needs
    // to rate-limit by uid/IP and check real proof of interaction (a booking or an accepted
    // admission application) before granting the "Verified Student" badge, neither of which a
    // bare client-side create could safely enforce.
    function isOwnerReplyingToOwnApprovedReview() {
      let d = resource.data;
      return (
        (d.tutorId is string && isOwnerTutor(d.tutorId))
        || (d.institutionId is string && isOwnerInstitution(d.institutionId))
      )
        && d.status == 'APPROVED'
        && request.resource.data.diff(d).affectedKeys().hasOnly(['reply']);
    }

    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'APPROVED' || isSuperAdmin();
      allow create: if false;
      allow update: if isSuperAdmin() || isOwnerReplyingToOwnApprovedReview();
      allow delete: if isSuperAdmin();
    }

    // Inquiries & Leads (Anyone can create inquiry; recipient institution or admin can read/reply)
    function isInstitutionUpdatingOwnInquiry() {
      return isOwnerInstitution(resource.data.institutionId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reply']);
    }

    match /inquiries/{inquiryId} {
      allow create: if isValidInquiry();
      allow read: if isSuperAdmin() || isOwnerInstitution(resource.data.institutionId);
      allow update: if isSuperAdmin() || isInstitutionUpdatingOwnInquiry();
      allow delete: if isSuperAdmin();
    }

    // Join Applications (tutor/institution). Anyone can apply; only superadmin reviews.
    // Approval for tutors goes through the Admin SDK API route (/api/applications/[id]/approve)
    // so account provisioning + custom claims stay server-side.
    match /applications/{applicationId} {
      allow create: if isValidApplication();
      allow read, update, delete: if isSuperAdmin();
    }

    // Jobs (institution or employer postings — exactly one of institutionId/employerId is set).
    // Anyone can browse ACTIVE jobs; owner/admin see DRAFT/CLOSED too.
    match /jobs/{jobId} {
      allow read: if resource.data.status == 'ACTIVE' || isSuperAdmin() || isOwnerOfJob(resource.data);
      allow write: if isSuperAdmin() || isOwnerOfJob(resource.data) || isOwnerOfJob(request.resource.data);
    }

    // Job Applications (guest apply, no account required). Creation is Admin SDK only
    // (/api/job-applications) — see below — so it can be rate-limited by IP; only the owning
    // institution/employer or admin can read/triage, and the applicant's own view goes through
    // the phone-verified Admin SDK route (/api/job-applications/lookup), same guest pattern as
    // booking lookup used to be.
    function isOwnerUpdatingOwnJobApplication() {
      return isOwnerOfJob(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'internalNotes', 'updatedAt']);
    }

    match /jobApplications/{applicationId} {
      // Admin SDK only (/api/job-applications) — rate-limited by IP rather than trusting
      // freely-mintable anonymous Firebase Auth sessions.
      allow create: if false;
      allow read: if isSuperAdmin() || isOwnerOfJob(resource.data);
      allow update: if isSuperAdmin() || isOwnerUpdatingOwnJobApplication();
      allow delete: if isSuperAdmin();
    }

    // Admission Applications (a student applying to an institution's program). Unlike
    // JobApplication above, creation and status decisions both go through Admin SDK API routes
    // (/api/admission-applications, /api/institution/admission-applications/[id]/decision)
    // instead of direct client writes — accepting an applicant has to atomically check and
    // increment the program's capacity (a denormalized count on the Institution doc), which a
    // bare security rule can't safely enforce across two documents against concurrent writers.
    // The student side reads their own applications via /api/account/admission-applications
    // (their uid is verified server-side from the session); direct client reads still work for
    // the student's own docs below in case a future UI wants them, scoped by studentId.
    match /admissionApplications/{applicationId} {
      allow create: if false;
      allow read: if isSuperAdmin() || isOwnerInstitution(resource.data.get('institutionId', null)) || isOwner(resource.data.get('studentId', null));
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // Community discussion boards (governorate-scoped Q&A). New threads are moderated (public UGC,
    // not scoped to one institution the way inquiries/reviews are); replies go live immediately
    // once their parent thread is approved, so ongoing moderation stays light. Post creation
    // itself is Admin SDK only (/api/community-posts) — see the match block below.

    // A guest reply bumps the parent post's replyCount by exactly 1 — the only field a non-admin
    // is ever allowed to touch on a community post.
    function isGuestAddingReplyCount() {
      return resource.data.status == 'APPROVED'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount'])
        && request.resource.data.replyCount == resource.data.replyCount + 1;
    }

    match /communityPosts/{postId} {
      // Admin SDK only (/api/community-posts) — rate-limited by IP rather than trusting
      // freely-mintable anonymous Firebase Auth sessions.
      allow create: if false;
      allow read: if resource.data.status == 'APPROVED' || isSuperAdmin();
      allow update: if isSuperAdmin() || (isAuthenticated() && isGuestAddingReplyCount());
      allow delete: if isSuperAdmin();

      function isValidCommunityReply() {
        let d = request.resource.data;
        return d.authorName is string && d.authorName.size() > 0 && d.authorName.size() <= 100
          && d.body is string && d.body.size() > 0 && d.body.size() <= 2000
          && get(/databases/$(database)/documents/communityPosts/$(postId)).data.status == 'APPROVED';
      }

      match /replies/{replyId} {
        allow read: if isSuperAdmin() || get(/databases/$(database)/documents/communityPosts/$(postId)).data.status == 'APPROVED';
        allow create: if isAuthenticated() && isValidCommunityReply();
        allow delete: if isSuperAdmin();
      }
    }

    // Messaging: one thread per context (a Booking, an Inquiry, or a JobApplication), doc id ==
    // that context's id. The tutor/institution owner is authenticated and reads/writes directly
    // here. The student side of booking threads goes through the account-authenticated
    // /api/account/bookings/[id]/messages route (session-verified uid). Guests (parents/
    // applicants) on inquiries/job applications still have no account requirement, so their side
    // goes through /api/inquiries/[id]/messages or /api/job-applications/[id]/messages, which
    // verify their phone against the inquiry/application before touching these docs. `.get(key, null)` is used instead of
    // dot-notation because exactly one of tutorId/institutionId is ever set on a given thread,
    // and dot-notation access to a genuinely absent map key throws in this rules version.
    function isOwnerOfThread(data) {
      return isOwnerTutor(data.get('tutorId', null)) || isOwnerInstitution(data.get('institutionId', null));
    }

    match /threads/{threadId} {
      allow read: if isSuperAdmin() || isOwnerOfThread(resource.data);
      allow create: if isSuperAdmin() || isOwnerOfThread(request.resource.data);
      allow update: if isSuperAdmin() || isOwnerOfThread(resource.data);
      allow delete: if isSuperAdmin();

      match /messages/{messageId} {
        allow read, create: if isSuperAdmin()
          || isOwnerOfThread(get(/databases/$(database)/documents/threads/$(threadId)).data);
      }
    }

    // Student accounts — required to book a tutor. Doc id == the student's own Auth uid, so
    // isOwner() is a direct fit. Bookings/threads for a logged-in student are still read via
    // /api/account/* (their uid is verified server-side from the session, not trusted from a
    // client-side Firestore query).
    match /students/{studentId} {
      allow read, write: if isSuperAdmin() || isOwner(studentId);

      // Web push subscriptions — Admin SDK only (/api/push/subscribe, /api/push/unsubscribe),
      // never touched by the client SDK directly.
      match /pushSubscriptions/{subId} {
        allow read, write: if false;
      }

      // Saved searches — a manual "bookmark this filter combination" convenience, no automatic
      // matching/alerting yet (that would need a scheduled job to check for new listings, out of
      // scope for now). Plain owner-scoped CRUD, same as the student doc itself.
      match /savedSearches/{searchId} {
        allow read, write: if isSuperAdmin() || isOwner(studentId);
      }
    }

    // In-house error log (no third-party monitoring account needed) — created/updated only via
    // the Admin SDK (/api/errors for client-reported errors, logServerError() for server-side
    // ones), never directly by a client, since a report can come from a fully logged-out visitor.
    // Deleting (clearing a resolved entry from /admin/errors) is a direct client-SDK write though,
    // same as every other admin moderation action in this file.
    match /errorLogs/{errorId} {
      allow read, delete: if isSuperAdmin();
      allow create, update: if false;
    }

    // Server-side rate-limit counters (checkRateLimit()) — internal bookkeeping only, never
    // read or written by any client.
    match /rateLimits/{key} {
      allow read, write: if false;
    }
  }
}
