rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Role Helpers
    function isAuthenticated() {
      return request.auth != null;
    }
    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.role == 'superadmin';
    }

    // Scoped admin roles — see src/core/permissions.ts, which is the readable copy of this table
    // and the one proxy.ts and the API routes check against. Superadmin satisfies every capability
    // below, so each helper includes it rather than each call site having to remember to.
    //
    // canEditDirectory: institutions, tutors, employers, jobs and the taxonomies behind them.
    // canModerate:      the submission queues — join applications, reviews, inquiries, community.
    // isAdmin:          any of the three, for the read-only views of the admin area.
    function canEditDirectory() {
      return isSuperAdmin() || (isAuthenticated() && request.auth.token.role == 'editor');
    }

    function canModerate() {
      return isSuperAdmin() || (isAuthenticated() && request.auth.token.role == 'moderator');
    }

    function isAdmin() {
      return isSuperAdmin() || canEditDirectory() || canModerate();
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isOwnerTutor(tutorId) {
      return isAuthenticated() && request.auth.token.role == 'tutor' && request.auth.token.tutorId == tutorId;
    }

    function isOwnerInstitution(instId) {
      return isAuthenticated() && request.auth.token.role == 'institution' && request.auth.token.institutionId == instId;
    }

    function isOwnerEmployer(employerId) {
      return isAuthenticated() && request.auth.token.role == 'employer' && request.auth.token.employerId == employerId;
    }

    // A Job/JobApplication has exactly one of institutionId/employerId set — same pattern as
    // Review's institutionId?/tutorId?. `.get(key, null)` handles the genuinely-absent-field case.
    function isOwnerOfJob(data) {
      return isOwnerInstitution(data.get('institutionId', null)) || isOwnerEmployer(data.get('employerId', null));
    }

    // Same "exactly one owner" shape as isOwnerOfJob, for Events (institution- or NGO-posted).
    function isOwnerOfEvent(data) {
      return isOwnerInstitution(data.get('institutionId', null)) || isOwnerEmployer(data.get('employerId', null));
    }

    // ---- Owner-write guards ----------------------------------------------------------------
    // Institution/tutor/employer/job owners write their own documents straight from the browser
    // with the client SDK, so a rule is the only thing standing between them and the fields that
    // decide public ranking, the verification badge, and the JSON-LD aggregateRating we hand to
    // Google. Everything an owner must not self-award is listed per-collection below and checked
    // through here. Superadmin writes bypass these entirely.
    //
    // `diff().affectedKeys()` reports only keys whose value actually CHANGES, so the dashboards'
    // whole-document setDoc(..., {merge: true}) still passes: it writes these fields back
    // untouched, because no owner-facing form ever exposes them.
    function keepsReservedFields(reserved) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(reserved);
    }

    // An owner may pause and resume their own listing, but may never walk a PENDING profile to
    // ACTIVE — that approval is the admin's call. Institutions and tutors both use
    // ACTIVE<->SUSPENDED for the owner-controlled pause, keeping PENDING to mean "not yet
    // approved" and nothing else.
    function statusStaysWithin(allowed) {
      return request.resource.data.status == resource.data.status
        || (resource.data.status in allowed && request.resource.data.status in allowed);
    }

    // Ownership of an existing profile doc, by either the linked uid or the role-scoped claim.
    // `.get('userId', '')` keeps this safe on documents predating the userId field.
    function ownsInstitutionDoc(instId) {
      return isOwner(resource.data.get('userId', '')) || isOwnerInstitution(instId);
    }

    function ownsTutorDoc(tutorId) {
      return isOwner(resource.data.get('userId', '')) || isOwnerTutor(tutorId);
    }

    function ownsEmployerDoc(employerId) {
      return isOwner(resource.data.get('userId', '')) || isOwnerEmployer(employerId);
    }

    function isValidInquiry() {
      let d = request.resource.data;
      return d.institutionId is string && d.institutionId.size() > 0
        && exists(/databases/$(database)/documents/institutions/$(d.institutionId))
        && d.fullName is string && d.fullName.size() > 0 && d.fullName.size() <= 100
        && d.phone is string && d.phone.size() > 0 && d.phone.size() <= 30
        && d.message is string && d.message.size() <= 2000
        && d.status == 'NEW';
    }

    function isValidApplication() {
      let d = request.resource.data;
      return d.type in ['TUTOR', 'INSTITUTION', 'EMPLOYER']
        && d.fullName is string && d.fullName.size() > 0 && d.fullName.size() <= 150
        && d.email is string && d.email.size() > 0 && d.email.size() <= 200
        && d.phone is string && d.phone.size() > 0 && d.phone.size() <= 30
        && d.governorateId is string && d.governorateId.size() > 0
        && d.message is string && d.message.size() <= 3000
        && d.status == 'PENDING'
        && (d.type != 'INSTITUTION' || (d.categoryId is string && d.categoryId.size() > 0))
        && (d.type != 'EMPLOYER' || d.employerType in ['COMPANY', 'NGO']);
    }

    // Dynamic Master Data (Locations, Categories, Taxonomies, Settings): Public Read, Superadmin Write
    match /locations_governorates/{govId} {
      allow read: if true;
      allow write: if canEditDirectory();
      match /cities/{cityId} {
        allow read: if true;
        allow write: if canEditDirectory();
      }
    }

    match /categories/{catId} {
      allow read: if true;
      allow write: if canEditDirectory();
      match /subcategories/{subId} {
        allow read: if true;
        allow write: if canEditDirectory();
      }
    }

    match /taxonomies_master/{taxId} {
      allow read: if true;
      allow write: if canEditDirectory();
    }

    // Homepage ad-banner campaigns. Public read (the homepage picks one client-side from whatever
    // is eligible today); write is direct client-SDK from /admin/banners, same as the taxonomies
    // block above — the save path calls revalidatePublicData('masterData') itself, it just does so
    // over HTTP rather than needing this write to go through the Admin SDK.
    match /cms_banners/{bannerId} {
      allow read: if true;
      allow write: if canEditDirectory();
    }

    // Writes go through /api/admin/settings (Admin SDK) only, not a direct client-SDK write, so a
    // save can call revalidatePublicData() — Navbar/Footer/HomeContent read this doc through a
    // cached snapshot, and nothing else was ever telling that cache to drop on an edit.
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if false;
    }

    // Homepage quick-search chips. Previously this master-data type lived only in seedData.json
    // and was never persisted anywhere, so it had no collection and no rule.
    match /quick_search_tags/{tagId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Institutions Directory
    match /institutions/{instId} {
      allow read: if resource.data.status == 'ACTIVE' || isAdmin() || isOwnerInstitution(instId);
      // Profiles are provisioned by Admin SDK routes. Keeping admin writes off the client rules is
      // what prevents a browser from bypassing the publishing gate in /api/admin/institutions.
      allow create: if false;
      allow update: if (
        ownsInstitutionDoc(instId)
        && keepsReservedFields(['id', 'userId', 'isVerified', 'verificationBadgeLabel', 'isFeatured', 'metrics', 'createdAt'])
        && statusStaysWithin(['ACTIVE', 'SUSPENDED'])
      );
      // Self-service account deletion (re-authenticated in the dashboard) stays available.
      allow delete: if ownsInstitutionDoc(instId);
      match /programs/{progId} {
        allow read: if true;
        allow write: if canEditDirectory() || isOwnerInstitution(instId);
      }

      // Verification/accreditation documents — same private-subcollection pattern as tutors,
      // since the institution doc above is world-readable once status is 'ACTIVE' with no
      // field-level restriction, and Storage download-URL tokens bypass storage.rules anyway.
      match /private/{docId} {
        allow read, write: if canEditDirectory() || isOwnerInstitution(instId);
      }
    }

    // Private Tutors Directory
    match /tutors/{tutorId} {
      allow read: if resource.data.status == 'ACTIVE' || isAdmin() || isOwnerTutor(tutorId);
      allow create: if canEditDirectory();
      allow update: if canEditDirectory() || (
        ownsTutorDoc(tutorId)
        && keepsReservedFields(['id', 'userId', 'isVerified', 'verificationBadgeLabel', 'verificationRequestStatus', 'ratingAvg', 'reviewCount', 'createdAt'])
        && statusStaysWithin(['ACTIVE', 'SUSPENDED'])
      );
      allow delete: if canEditDirectory() || ownsTutorDoc(tutorId);

      // Verification documents (ID/certificate photos) live here instead of on the tutor doc
      // above, because that doc's read rule has no field-level restriction — anything on it
      // is world-readable the moment status is 'ACTIVE'. Storage download-URL tokens also
      // bypass storage.rules on a direct fetch, so keeping these URLs off the public doc is
      // the only real privacy boundary for identity documents.
      //
      // The owner may still write `documents` directly (their own upload widget), but may only
      // ever leave `status` at 'NONE' or 'PENDING' — actually submitting for review and every
      // review decision goes through /api/tutor/verification/submit and
      // /api/admin/tutors/[id]/verification/{approve,reject} (Admin SDK, bypasses this rule
      // entirely), so an owner can never write themselves straight to APPROVED.
      match /private/{docId} {
        allow read: if canEditDirectory() || isOwnerTutor(tutorId);
        allow write: if canEditDirectory() || (
          isOwnerTutor(tutorId) && request.resource.data.get('status', 'NONE') in ['NONE', 'PENDING']
        );
      }

      // Web push subscriptions — Admin SDK only (/api/push/subscribe, /api/push/unsubscribe),
      // same pattern as students/{id}/pushSubscriptions below.
      match /pushSubscriptions/{subId} {
        allow read, write: if false;
      }
    }

    // Employers (companies/NGOs) — narrower than Institutions: no public directory profile page,
    // no programs/verification-docs subcollection, they only ever get read for job-listing display.
    match /employers/{employerId} {
      allow read: if resource.data.status == 'ACTIVE' || isAdmin() || isOwnerEmployer(employerId);
      allow create: if canEditDirectory();
      // No owner-facing pause for employers, so `status` is admin-only here rather than being
      // covered by statusStaysWithin().
      allow update: if canEditDirectory() || (
        ownsEmployerDoc(employerId)
        && keepsReservedFields(['id', 'userId', 'status', 'createdAt'])
      );
      allow delete: if canEditDirectory() || ownsEmployerDoc(employerId);
    }

    // Tutoring Session Bookings (individual or group). Writes only via the Admin SDK
    // API route (/api/bookings), which requires a logged-in student session, so group-join
    // price recalculation stays transactional and student contact info in `participants`
    // isn't exposed to arbitrary readers.
    match /bookings/{bookingId} {
      allow read: if isAdmin() || isOwnerTutor(resource.data.tutorId);
      allow update, delete: if canEditDirectory() || isOwnerTutor(resource.data.tutorId);
      allow create: if false;
    }

    // Sanitized per-(booking, participant) mirror of a Booking, for a student's own realtime
    // dashboard — deliberately excludes the `participants`/`participantStudentIds` arrays a full
    // Booking doc carries, which would otherwise expose every co-participant's name and phone
    // number to any one member of a GROUP booking. Written only by the Admin SDK routes that
    // already touch a booking (create, join, status change); never by a client.
    match /bookingViews/{viewId} {
      allow read: if isAdmin() || isOwner(resource.data.get('studentId', null));
      allow write: if false;
    }

    // User Reviews (Public read approved). Creation is Admin SDK only (/api/reviews) — it needs
    // to rate-limit by uid/IP and check real proof of interaction (a booking or an accepted
    // admission application) before granting the "Verified Student" badge, neither of which a
    // bare client-side create could safely enforce.
    function isOwnerReplyingToOwnApprovedReview() {
      let d = resource.data;
      return (
        (d.tutorId is string && isOwnerTutor(d.tutorId))
        || (d.institutionId is string && isOwnerInstitution(d.institutionId))
      )
        && d.status == 'APPROVED'
        && request.resource.data.diff(d).affectedKeys().hasOnly(['reply']);
    }

    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'APPROVED' || canModerate();
      allow create: if false;
      // Moderation (status changes) and deletion are Admin SDK only, via
      // /api/admin/reviews/[id] — both have to move the reviewed party's rating aggregates in the
      // same transaction, which a client-side write cannot do atomically. Even the superadmin
      // goes through the route: leaving a direct client write open here is precisely how the
      // aggregates drifted out of step with the reviews before. The one client write still
      // allowed is an owner attaching a public reply, which touches no aggregate.
      allow update: if isOwnerReplyingToOwnApprovedReview();
      allow delete: if false;
    }

    // Inquiries & Leads (Anyone can create inquiry; recipient institution or admin can triage
    // status — the actual reply happens over the unified messaging/threads system, not on this
    // doc, so the only field an institution ever legitimately changes here is `status`).
    function isInstitutionUpdatingOwnInquiry() {
      return isOwnerInstitution(resource.data.institutionId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['NEW', 'CONTACTED', 'QUALIFIED', 'APPLICATION_STARTED', 'CLOSED'];
    }

    match /inquiries/{inquiryId} {
      allow create: if isValidInquiry();
      allow read: if canModerate() || isOwnerInstitution(resource.data.institutionId);
      // Moderation metadata and response timing are written by the Admin SDK route. Keeping the
      // browser limited to an institution's own status transition prevents a moderator from
      // bypassing validation, audit logging, or reminder bookkeeping with a raw client write.
      allow update: if isInstitutionUpdatingOwnInquiry();
      allow delete: if canModerate();
    }

    // Join Applications (tutor/institution). Anyone can apply; a moderator or superadmin reviews.
    // Approval for tutors goes through the Admin SDK API route (/api/applications/[id]/approve)
    // so account provisioning + custom claims stay server-side.
    match /applications/{applicationId} {
      allow create: if isValidApplication();
      allow read, update, delete: if canModerate();
    }

    // Jobs (institution or employer postings — exactly one of institutionId/employerId is set).
    // Anyone can browse ACTIVE jobs; owner/admin see DRAFT/CLOSED too.
    match /jobs/{jobId} {
      allow read: if resource.data.status == 'ACTIVE' || isAdmin() || isOwnerOfJob(resource.data);
      // A new job must be posted under the poster's own institution/employer id and must start
      // with an untouched applicant counter.
      allow create: if canEditDirectory() || (
        isOwnerOfJob(request.resource.data)
        && request.resource.data.get('applicantCount', 0) == 0
      );
      // `applicantCount` is maintained atomically by /api/job-applications via the Admin SDK, so
      // it is off-limits here; the ownership fields are frozen so a job can't be reassigned.
      allow update: if canEditDirectory() || (
        isOwnerOfJob(resource.data)
        && keepsReservedFields(['id', 'institutionId', 'employerId', 'applicantCount', 'createdAt'])
      );
      allow delete: if canEditDirectory() || isOwnerOfJob(resource.data);
    }

    // Job Applications (guest apply, no account required). Creation is Admin SDK only
    // (/api/job-applications) — see below — so it can be rate-limited by IP; only the owning
    // institution/employer or admin can read/triage, and the applicant's own view goes through
    // the phone-verified Admin SDK route (/api/job-applications/lookup), same guest pattern as
    // booking lookup used to be.
    function isOwnerUpdatingOwnJobApplication() {
      return isOwnerOfJob(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'internalNotes', 'updatedAt']);
    }

    match /jobApplications/{applicationId} {
      // Admin SDK only (/api/job-applications) — rate-limited by IP rather than trusting
      // freely-mintable anonymous Firebase Auth sessions.
      allow create: if false;
      allow read: if isAdmin() || isOwnerOfJob(resource.data) || isOwner(resource.data.get('studentId', null));
      allow update: if canEditDirectory() || isOwnerUpdatingOwnJobApplication();
      allow delete: if canEditDirectory();
    }

    // Events (institution or NGO-employer postings — exactly one of institutionId/employerId is
    // set, same shape as Jobs). Registration is external-link/WhatsApp only, so — unlike Jobs —
    // there's no applicant sub-collection or counter to protect here.
    match /events/{eventId} {
      allow read: if resource.data.status == 'ACTIVE' || isAdmin() || isOwnerOfEvent(resource.data);
      allow create: if canEditDirectory() || isOwnerOfEvent(request.resource.data);
      allow update: if canEditDirectory() || (
        isOwnerOfEvent(resource.data)
        && keepsReservedFields(['id', 'institutionId', 'employerId', 'createdAt'])
      );
      allow delete: if canEditDirectory() || isOwnerOfEvent(resource.data);
    }

    // Admission Applications (a student applying to an institution's program). Unlike
    // JobApplication above, creation and status decisions both go through Admin SDK API routes
    // (/api/admission-applications, /api/institution/admission-applications/[id]/decision)
    // instead of direct client writes — accepting an applicant has to atomically check and
    // increment the program's capacity (a denormalized count on the Institution doc), which a
    // bare security rule can't safely enforce across two documents against concurrent writers.
    // The student side reads their own applications via /api/account/admission-applications
    // (their uid is verified server-side from the session); direct client reads still work for
    // the student's own docs below in case a future UI wants them, scoped by studentId.
    match /admissionApplications/{applicationId} {
      allow create: if false;
      allow read: if isAdmin() || isOwnerInstitution(resource.data.get('institutionId', null)) || isOwner(resource.data.get('studentId', null));
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // Community discussion boards (governorate-scoped Q&A). New threads are moderated (public UGC,
    // not scoped to one institution the way inquiries/reviews are); replies go live immediately
    // once their parent thread is approved, so ongoing moderation stays light. Post creation
    // itself is Admin SDK only (/api/community-posts) — see the match block below.

    // A guest reply bumps the parent post's replyCount by exactly 1 — the only field a non-admin
    // is ever allowed to touch on a community post.
    function isGuestAddingReplyCount() {
      return resource.data.status == 'APPROVED'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount'])
        && request.resource.data.replyCount == resource.data.replyCount + 1;
    }

    // A guest toggling the "helpful" like bumps helpfulCount by exactly +-1, paired client-side
    // with creating/deleting their own communityPosts/{postId}/likes/{uid} doc (below) so the
    // same identity can't like a post more than once.
    function isGuestTogglingHelpfulCount() {
      return resource.data.status == 'APPROVED'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['helpfulCount'])
        && (request.resource.data.helpfulCount == resource.data.get('helpfulCount', 0) + 1
          || request.resource.data.helpfulCount == resource.data.get('helpfulCount', 0) - 1);
    }

    match /communityPosts/{postId} {
      // Admin SDK only (/api/community-posts) — rate-limited by IP rather than trusting
      // freely-mintable anonymous Firebase Auth sessions.
      allow create: if false;
      allow read: if resource.data.status == 'APPROVED' || canModerate();
      allow update: if canModerate() || (isAuthenticated() && (isGuestAddingReplyCount() || isGuestTogglingHelpfulCount()));
      allow delete: if canModerate();

      function isValidCommunityReply() {
        let d = request.resource.data;
        return d.authorName is string && d.authorName.size() > 0 && d.authorName.size() <= 100
          && d.body is string && d.body.size() > 0 && d.body.size() <= 2000
          && get(/databases/$(database)/documents/communityPosts/$(postId)).data.status == 'APPROVED';
      }

      match /replies/{replyId} {
        allow read: if canModerate() || get(/databases/$(database)/documents/communityPosts/$(postId)).data.status == 'APPROVED';
        allow create: if isAuthenticated() && isValidCommunityReply();
        allow delete: if canModerate();
      }

      // One "helpful" like per identity — the doc's existence IS the like, so its id is the
      // liker's own uid (own-doc-only, same reasoning as isOwner elsewhere in this file).
      match /likes/{uid} {
        allow read: if isAuthenticated() && request.auth.uid == uid;
        allow create: if isAuthenticated() && request.auth.uid == uid
          && get(/databases/$(database)/documents/communityPosts/$(postId)).data.status == 'APPROVED';
        allow delete: if isAuthenticated() && request.auth.uid == uid;
      }
    }

    // Messaging: one thread per context (a Booking, an Inquiry, or a JobApplication), doc id ==
    // that context's id. The tutor/institution owner is authenticated and reads/writes directly
    // here. The student side of booking threads goes through the account-authenticated
    // /api/account/bookings/[id]/messages route (session-verified uid). Guests (parents/
    // applicants) on inquiries/job applications still have no account requirement, so their side
    // goes through /api/inquiries/[id]/messages or /api/job-applications/[id]/messages, which
    // verify their phone against the inquiry/application before touching these docs. `.get(key, null)` is used instead of
    // dot-notation because exactly one of tutorId/institutionId is ever set on a given thread,
    // and dot-notation access to a genuinely absent map key throws in this rules version.
    function isOwnerOfThread(data) {
      return isOwnerTutor(data.get('tutorId', null)) || isOwnerInstitution(data.get('institutionId', null));
    }

    // A booking thread also denormalizes participantStudentIds (kept in sync by the Admin SDK
    // routes that create/update it), so a student who's actually part of that booking can read
    // the conversation and mark it read directly, the same way the owning tutor already does.
    //
    // Inquiry threads carry no studentId — a guest can open one with only a phone number — so a
    // logged-in student is matched on their `phone` custom claim instead. That claim is set
    // server-side at signup and is exactly what /api/account/inquiries already authorizes on, so
    // this grants the client nothing the account API wouldn't already hand the same user.
    function isParticipantStudent(data) {
      return isAuthenticated() && (
        data.get('participantStudentIds', []).hasAny([request.auth.uid])
        || (request.auth.token.get('phone', '') != ''
            && data.get('participantPhones', []).hasAny([request.auth.token.get('phone', '')]))
      );
    }

    match /threads/{threadId} {
      allow read: if isAdmin() || isOwnerOfThread(resource.data) || isParticipantStudent(resource.data);
      allow create: if isSuperAdmin() || isOwnerOfThread(request.resource.data);
      // A participant student may only ever touch their own `readBy` entry — never the message
      // content, the participant list, or anyone else's read receipt.
      allow update: if isSuperAdmin() || isOwnerOfThread(resource.data) || (
        isParticipantStudent(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
      );
      allow delete: if isSuperAdmin();

      match /messages/{messageId} {
        allow read: if isAdmin()
          || isOwnerOfThread(get(/databases/$(database)/documents/threads/$(threadId)).data)
          || isParticipantStudent(get(/databases/$(database)/documents/threads/$(threadId)).data);
        allow create: if isSuperAdmin()
          || isOwnerOfThread(get(/databases/$(database)/documents/threads/$(threadId)).data);
      }
    }

    // Student accounts — required to book a tutor. Doc id == the student's own Auth uid, so
    // isOwner() is a direct fit. Raw Booking docs stay read via /api/account/* (a full Booking's
    // `participants` array holds every co-participant's name/phone — too much to hand a client
    // directly); the sanitized live view is `bookingViews` above, and thread reads are scoped via
    // isParticipantStudent() above.
    match /students/{studentId} {
      allow read, write: if isSuperAdmin() || isOwner(studentId);

      // Web push subscriptions — Admin SDK only (/api/push/subscribe, /api/push/unsubscribe),
      // never touched by the client SDK directly.
      match /pushSubscriptions/{subId} {
        allow read, write: if false;
      }

      // Saved searches — a manual "bookmark this filter combination" convenience, no automatic
      // matching/alerting yet (that would need a scheduled job to check for new listings, out of
      // scope for now). Plain owner-scoped CRUD, same as the student doc itself.
      match /savedSearches/{searchId} {
        allow read, write: if isSuperAdmin() || isOwner(studentId);
      }
    }

    // In-house error log (no third-party monitoring account needed) — created/updated only via
    // the Admin SDK (/api/errors for client-reported errors, logServerError() for server-side
    // ones), never directly by a client, since a report can come from a fully logged-out visitor.
    // Deleting (clearing a resolved entry from /admin/errors) is a direct client-SDK write though,
    // same as every other admin moderation action in this file.
    match /errorLogs/{errorId} {
      allow read, delete: if isSuperAdmin();
      allow create, update: if false;
    }

    // Server-side rate-limit counters (checkRateLimit()) — internal bookkeeping only, never
    // read or written by any client.
    match /rateLimits/{key} {
      allow read, write: if false;
    }

    // The audit trail. Append-only from the server's point of view and immutable from everywhere
    // else: a log that the people it records can edit or delete is not a log. Superadmins read it
    // through /admin/audit; nothing writes it but the Admin SDK. Editors are excluded on
    // purpose — the people whose directory edits it records shouldn't also curate the record.
    match /auditLogs/{entryId} {
      allow read: if isSuperAdmin() || canModerate();
      allow write: if false;
    }

    // Precomputed /admin/analytics figures, written only by the scheduled `analytics` task via
    // the Admin SDK. Readable by any admin role so /admin/analytics can load it directly; a
    // client write would let someone fabricate the platform's own numbers.
    match /analytics_snapshots/{snapshotId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // In-App Notifications: readable and mark-read updatable only by the recipient.
    // Created only server-side via the Admin SDK.
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if isSuperAdmin();
    }

    // Direct 1:1 Conversations: readable and updatable only by members of participantIds.
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && resource.data.participantIds.hasAny([request.auth.uid]);
      allow create: if isAuthenticated() && request.resource.data.participantIds.hasAny([request.auth.uid]);
      allow update: if isAuthenticated() && resource.data.participantIds.hasAny([request.auth.uid]);
      allow delete: if isSuperAdmin();

      match /messages/{messageId} {
        allow read: if isAuthenticated()
          && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds.hasAny([request.auth.uid]);
        allow create: if isAuthenticated()
          && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds.hasAny([request.auth.uid])
          && request.resource.data.senderId == request.auth.uid;
        allow update: if isAuthenticated()
          && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds.hasAny([request.auth.uid])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
        allow delete: if isSuperAdmin();
      }
    }
  }
}
