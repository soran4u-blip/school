rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.role == 'superadmin';
    }
    function isOwnerTutor(tutorId) {
      return request.auth != null && request.auth.token.role == 'tutor' && request.auth.token.tutorId == tutorId;
    }
    function isOwnerInstitution(institutionId) {
      return request.auth != null && request.auth.token.role == 'institution' && request.auth.token.institutionId == institutionId;
    }
    function isValidImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    function isValidVerificationDoc() {
      return request.resource.size < 5 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }
    function isValidResumeDoc() {
      return request.resource.size < 5 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf'
            || request.resource.contentType.matches('application/.*document.*'));
    }

    match /institutions/{institutionId}/{fileName} {
      allow read: if true;
      allow write: if (isSuperAdmin() || isOwnerInstitution(institutionId)) && isValidImage();
    }

    // Accreditation documents backing an institution's verification — private, same reasoning
    // as the tutor equivalent below.
    match /institutions/{institutionId}/verification/{fileName} {
      allow read: if isSuperAdmin() || isOwnerInstitution(institutionId);
      allow write: if (isSuperAdmin() || isOwnerInstitution(institutionId)) && isValidVerificationDoc();
    }

    match /tutors/{tutorId}/{fileName} {
      allow read: if true;
      allow write: if (isSuperAdmin() || isOwnerTutor(tutorId)) && isValidImage();
    }

    // ID/certificate documents backing a tutor's verification — private (identity documents),
    // unlike the public profile photo above. Only the tutor themself and superadmin can read.
    match /tutors/{tutorId}/verification/{fileName} {
      allow read: if isSuperAdmin() || isOwnerTutor(tutorId);
      allow write: if (isSuperAdmin() || isOwnerTutor(tutorId)) && isValidVerificationDoc();
    }

    // Resumes attached to a job application. The applicant is a guest (anonymous auth only, same
    // posture as a review submission) uploading before the application doc exists, so ownership
    // can't be checked here — instead the path embeds institutionId so only that institution (or
    // admin) can read it back, matching the verification-doc paths above.
    match /job-applications/{institutionId}/{jobId}/{fileName} {
      allow read: if isSuperAdmin() || isOwnerInstitution(institutionId);
      allow write: if request.auth != null && isValidResumeDoc();
    }
  }
}
